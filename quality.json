{
	"$schema": "./node_modules/@yuu1111/quality-check/schema.json",
	"failOnWarnings": true,
	"baseline": false,
	"biome": {
		"enabled": true
	},
	"typecheck": {
		"enabled": true,
		"projects": [
			"tsconfig.json",
			"tsconfig.build.json"
		]
	},
	"knip": {
		"enabled": true
	},
	"code-style-check": {
		"enabled": true,
		"includes": [
			"**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
			"!node_modules/**",
			"!dist/**",
			"!.git/**"
		],
		"rules": {
			"preset": "all"
		}
	},
	"comment-check": {
		"enabled": true,
		"includes": [
			"**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
			"!node_modules/**",
			"!dist/**",
			"!.git/**"
		],
		"rules": {
			"preset": "all"
		}
	},
	"document-style-check": {
		"enabled": true,
		"includes": [
			"**/*.md",
			"!node_modules/**",
			"!dist/**",
			"!.git/**"
		],
		"rules": {
			"preset": "all"
		}
	},
	"tsdoc-check": {
		"enabled": true,
		"includes": [
			"**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
			"!node_modules/**",
			"!dist/**",
			"!.git/**"
		],
		"rules": {
			"preset": "all"
		},
		"styleScope": "documented",
		"docScope": "all"
	}
}
